    "#Sum_number\n",
    "def Sum_number():\n",
    "    numbers = []\n",
    "    while True:\n",
    "        user = input('Enter a number:')\n",
    "        \n",
    "        if user == '':\n",
    "            break\n",
    "        \n",
    "        numbers.append(int(user))\n",
    "        print(sum(numbers))\n",
    "    \n",
    "Sum_number()\n"
   ]
