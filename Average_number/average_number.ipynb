   ],
   "source": [
    "numbers = []\n",
    "\n",
    "while True:\n",
    "    user = input('Enter a number (Enter to stop):')\n",
    "    \n",
    "    if user =='':\n",
    "        break\n",
    "    \n",
    "    numbers.append(float(user))\n",
    "    \n",
    "average = sum(numbers) / len(numbers)\n",
    "\n",
    "print('Numbers:', numbers)\n",
    "print('-' * 30)\n",
    "print('Average:', average)"
   ]
  },
